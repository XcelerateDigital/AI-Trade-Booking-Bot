# Only 4 values needed. Full walkthrough: START-HERE.md

# Anthropic API key (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# GoHighLevel Private Integration token (Settings > Private Integrations)
GHL_API_TOKEN=

# Any long random password you invent. Must match the one in the GHL workflow URL.
WEBHOOK_SECRET=

# Business name used in the texts, e.g. "Smith Home Maintenance"
BUSINESS_NAME=

# --- Multiple clients (see CLIENT-SETUP.md) ---
# Each client's business profile lives in their GHL Custom Values ("AI Business Name", etc.).
# GHL_TOKENS={"<locationId>":"pit-...","<locationId2>":"pit-..."}

# --- Optional / single-client fallbacks (a client's GHL Custom Values override these) ---
# BUSINESS_TRADE=plumbing
# AI_MODEL=claude-sonnet-5-5
# TIMEZONE=Australia/Sydney
# GHL_CALENDAR_ID=   (turns on direct calendar booking)
# REPLY_DELAY_MS=8000   (wait this long for follow-up texts so double-texters get one reply)
